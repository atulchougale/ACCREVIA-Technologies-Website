# Copy to .env.local for local development. Only VITE_* values are exposed to the browser,
# so NEVER put secrets or tokens in these variables.

# Public URL of the FarmStay product (leave empty until it exists)
VITE_FARMSTAY_URL=

# Public base URL of this website, no trailing slash.
# Defaults to https://accreviatechnologies.online (used for canonical / Open Graph URLs, sitemap.xml, robots.txt).
VITE_SITE_URL=

# Google Analytics 4 Measurement ID (format G-XXXXXXXXXX). Leave EMPTY to keep analytics, the consent banner and
# any Google script completely disabled. When set, GA only loads after the visitor accepts the consent banner.
VITE_GA_MEASUREMENT_ID=
